algoritmo "Funcao Soma"

var
  total: inteiro

funcao somar(): inteiro
var
  n1, n2: inteiro
inicio
  escreva("Digite o primeiro número: ")
  leia(n1)
  escreva("Digite o segundo número: ")
  leia(n2)
  retorne n1 + n2
fimfuncao

inicio
  total <- somar()
  escreval(" A soma é: ", total)
fimalgoritmo